# ==============================================================================
# COFFEEBASE API — ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env)
# ==============================================================================
# NOTA IMPORTANTE:
# - Este archivo es para DESARROLLO LOCAL (en tu máquina).
# - Si vas a desplegar en RAILWAY o cualquier nube, NO uses 'localhost'.
#   Revisa la sección de Railway en el README.md para la configuración en producción.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------------------------
PORT=8080
ENV=development

# ------------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (DESARROLLO LOCAL)
# ------------------------------------------------------------------------------
# En tu máquina local puedes usar las variables individuales O DATABASE_URL:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coffeeshop

# Alternativa (si prefieres un string de conexión único):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/coffeeshop?sslmode=disable

# ------------------------------------------------------------------------------
# REDIS (DESARROLLO LOCAL)
# ------------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Alternativa para Redis:
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# CLAVES CRIPTOGRÁFICAS (Deben ser cadenas aleatorias largas y seguras)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_development_random_string_32_chars
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_development_32_chars
QR_TOKEN_SECRET=super_secret_qr_token_key_development_32_chars

# ------------------------------------------------------------------------------
# CORS (Orígenes frontend permitidos separados por comas)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# SEEDING DE USUARIOS (OPCIONAL)
# ------------------------------------------------------------------------------
# Si se deja vacío, el sistema crea en automático las cuentas por defecto:
# admin@coffeeshop.com / barista@coffeeshop.com / cliente@coffeeshop.com
# Formato personalizado: Username:Email:Password:Rol:Nombre:Apellido:PerfilOpcional
# SEED_USERS=admin:admin@coffeeshop.com:Admin1234!:superadmin:Admin:Boss:demo
